# SanaaAI — .env.example
#
# Consolidated from every env var referenced across ARCHITECTURE.md, CONVENTIONS.md §5,
# DATABASE.md, API_SPEC.md, SECURITY.md, and UI_SPEC.md. Values below are placeholders —
# never commit a real secret here. Per CONVENTIONS.md §3.6 and SECURITY.md §3: no credential
# in this file or any real .env file may be reachable from /apps/web; anything without the
# NEXT_PUBLIC_ prefix in the web section is a mistake.
#
# Per ARCHITECTURE.md's monorepo layout, this template covers all three apps (/apps/api,
# /apps/worker, /apps/web). In practice each app typically has its own .env — split this
# file accordingly at implementation time; it's consolidated here as one reference.
#
# Where an exact value, provider, or policy is still open, that is marked TBD and traced
# back to the document that first flagged it — do not fill in a guessed value.

# =============================================================================
# APP / ENVIRONMENT (api, worker)
# =============================================================================

# dev | staging | production — SECURITY.md §8 requires separate credentials per
# environment; this flag is how the app knows which credential set it's running with.
# Whether a dedicated staging environment is actually built: TBD (PRD.md §19.17,
# SECURITY.md §15's environment-related items).
NODE_ENV=development

# Port the NestJS API listens on.
PORT=4000

# Public base URL of the frontend — used for CORS (§ below), building password-reset
# links, and any other absolute link the backend needs to construct.
FRONTEND_URL=http://localhost:3000

# Public base URL of this API itself — API_SPEC.md §1 marks the production domain TBD.
API_BASE_URL=http://localhost:4000

# CORS allowed origin(s) — API_SPEC.md §15/§20.12, SECURITY.md §8: must be the real
# frontend origin(s) in production, never a wildcard. Comma-separated if more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE (api, worker)
# =============================================================================

# PostgreSQL connection string. DATABASE.md §1 — the database's own least-privilege
# role setup (SECURITY.md §8, §5.2) means this should NOT be a superuser/owner
# credential in production — a scoped application role, per DATABASE.md §6.3's
# recommendation to restrict wallet_transactions write access at the DB permission level.
DATABASE_URL=postgresql://user:password@localhost:5432/sanaaai

# =============================================================================
# REDIS / JOB QUEUE (api, worker)
# =============================================================================

# Redis connection string for BullMQ — ARCHITECTURE.md §2. Shared between the API
# (enqueues jobs) and the worker (consumes them).
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTH / JWT (api)
# =============================================================================

# Signing secret for JWTs — CONVENTIONS.md §5, SECURITY.md §2. Never reused across
# environments (SECURITY.md §3.4). Exact rotation cadence: TBD (SECURITY.md §15.2).
JWT_SECRET=

# Access token lifetime — API_SPEC.md §20.1, SECURITY.md §2 mark this TBD. Placeholder
# reflects the range SECURITY.md §2 suggested (15–60 min) pending confirmation.
JWT_ACCESS_TOKEN_TTL=30m

# Refresh token mechanism/lifetime — API_SPEC.md §20.1 marks the entire refresh
# strategy TBD. Only fill this in once that's decided; do not assume a refresh-token
# flow exists until confirmed.
JWT_REFRESH_TOKEN_TTL=

# Password hashing cost factor (bcrypt/argon2 — SECURITY.md §2 marks the exact
# algorithm/cost TBD). Leave unset until that decision is made; do not guess a value
# that then silently becomes the real production setting.
PASSWORD_HASH_COST=

# =============================================================================
# HIGGSFIELD (AI generation provider) — worker only, never api-web-reachable
# =============================================================================

# CONVENTIONS.md §5, PRD.md §11, API_SPEC.md §14.1: server-side only, never in
# /apps/web, never NEXT_PUBLIC_-prefixed. Exact credential shape (single key vs.
# key ID + secret pair) depends on Higgsfield's actual API — verify against live
# Higgsfield docs before finalizing these names.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Higgsfield API base URL — exact endpoint TBD (API_SPEC.md §14.1), verify against
# live Higgsfield documentation.
HIGGSFIELD_API_BASE_URL=

# Whether Higgsfield pushes job completion via its own webhook, requiring a
# POST /webhooks/higgsfield route with its own signature secret, or whether the
# worker must poll for status: TBD (API_SPEC.md §14.1, §20.9). Uncomment and fill
# in only once confirmed — do not assume a webhook exists.
# HIGGSFIELD_WEBHOOK_SECRET=

# =============================================================================
# SNIPPE (mobile money payments) — api and worker
# =============================================================================

# CONVENTIONS.md §5, PRD.md §14, API_SPEC.md §14.2: server-side only.
SNIPPE_API_KEY=

# Verifies inbound webhook authenticity — PRD.md §14.1 rule 3, SECURITY.md §4.1.
# Exact header/algorithm Snippe uses: TBD, verify against live Snippe docs before
# implementing the verification logic that consumes this.
SNIPPE_WEBHOOK_SECRET=

# Snippe API base URL — exact endpoint TBD (API_SPEC.md §14.2).
SNIPPE_API_BASE_URL=

# =============================================================================
# OBJECT STORAGE (api, worker)
# =============================================================================

# Provider choice itself is TBD (PRD.md §19.10, DATABASE.md §14.1 — Cloudflare R2
# vs. DigitalOcean Spaces vs. other, both S3-compatible). Variable names below use
# generic S3-compatible naming so either provider slots in without a rename.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Public CDN base URL for serving stored assets (if the provider/CDN setup uses a
# distinct public domain from the storage endpoint itself).
STORAGE_PUBLIC_CDN_URL=

# Lifetime of a signed/time-limited asset download URL — API_SPEC.md §11.7, §20.8;
# SECURITY.md §6 mark this TBD.
SIGNED_ASSET_URL_TTL_SECONDS=

# Storage credentials should be scoped to only this bucket/prefix, per SECURITY.md
# §6's least-privilege requirement — not a full-account storage credential. This is
# a provisioning requirement on the credential itself, not a separate env var.

# =============================================================================
# EMAIL (api) — password reset, per PRD.md §8
# =============================================================================

# Email provider/transport is not specified in any prior document — TBD. Placeholder
# names below assume an SMTP-compatible provider; adjust once a provider is chosen.
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# OBSERVABILITY / MONITORING (api, worker)
# =============================================================================

# Error-tracking tool (e.g. Sentry or equivalent) — provider TBD, PRD.md §19.16,
# SECURITY.md §9/§15.16. Must scrub PII/secrets from request bodies before events
# reach this service, per SECURITY.md §9 — leave unset until that scrubbing
# configuration is actually in place, not just once a DSN is obtained.
ERROR_TRACKING_DSN=

# General log verbosity.
LOG_LEVEL=info

# Alerting mechanism (e.g. for repeated webhook signature failures, wallet-balance
# constraint violations — SECURITY.md §9) — provider TBD, no placeholder variable
# name assumed here until one is chosen.

# =============================================================================
# RATE LIMITING (api)
# =============================================================================

# Exact thresholds are TBD throughout (API_SPEC.md §5, SECURITY.md §2/§4.5/§15.3/
# §15.7) — these are placeholders showing the shape (requests per window), not
# locked values. Do not treat the numbers below as decided.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_HOUR=
RATE_LIMIT_WEBHOOK_PER_MINUTE=

# =============================================================================
# ADMIN BOOTSTRAP (api) — one-time use only, see note
# =============================================================================

# SECURITY.md §11/§15.20 and DATABASE.md §7.2 both flag that the first production
# admin account must NOT be created via a hard-coded seed credential. These vars
# are placeholders for whatever bootstrap mechanism is eventually decided (e.g. a
# one-time CLI command consuming these, never a standing credential) — do not wire
# these into a database seed/migration that runs automatically in production until
# that mechanism is actually designed.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# =============================================================================
# FRONTEND (apps/web) — NEXT_PUBLIC_ only
# =============================================================================
#
# CONVENTIONS.md §5 / SECURITY.md §3.1: nothing above this line belongs in
# apps/web's .env file. Only NEXT_PUBLIC_-prefixed variables (which Next.js bundles
# into client-side JavaScript and are therefore NOT secret) may live here.

# Public API base URL the frontend calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Whether analytics/error-tracking has a public-side counterpart (e.g. a Sentry
# client DSN, which is safe to expose) — TBD, tied to the same provider decision
# as ERROR_TRACKING_DSN above.
NEXT_PUBLIC_ERROR_TRACKING_DSN=
