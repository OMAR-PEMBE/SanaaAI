{
  "name": "@sanaaai/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "role": "node --env-file=.env prisma/apply-role.mjs",
    "seed": "node --env-file=.env prisma/seed.mjs",
    "admin:create": "node --env-file=.env prisma/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.16.2",
    "typescript": "^5.9.3"
  }
}
